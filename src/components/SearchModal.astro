---
// Search Modal Component with global search across all documents
import { getCollection } from 'astro:content';

// Build search index at compile time from all MDX files
const allDocs = await getCollection('docs');

interface SearchItem {
  title: string;
  description: string;
  url: string;
  project: string;
  category: string;
  content: string;
}

const searchIndex: SearchItem[] = allDocs.map(doc => {
  const pathParts = doc.id.split('/');
  const project = 'docs';
  const category = pathParts[0] || 'General';
  
  return {
    title: doc.data.title || doc.id,
    description: doc.data.description || '',
    url: `/docs/${doc.id.replace(/\.mdx?$/, '')}`,
    project: project,
    category: category,
    content: typeof doc.body === 'string' ? doc.body.slice(0, 500) : ''
  };
});
---

<!-- Search Modal -->
<div id="search-modal" class="search-modal hidden">
  <div class="modal-backdrop" id="modal-backdrop"></div>
  <div class="modal-container" id="modal-container">
    <div class="modal-content" onclick="event.stopPropagation()">
      <div class="search-input-wrapper">
        <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="modal-search-input"
          placeholder="Search all documentation..."
          class="modal-search-input"
          autocomplete="off"
        />
        <button id="close-modal" class="close-btn">
          <kbd class="kbd-esc">ESC</kbd>
        </button>
      </div>
      <div id="modal-search-results" class="modal-results"></div>
    </div>
  </div>
</div>

<!-- Pass search index to client -->
<script define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<style is:global>
  .search-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483647 !important;
  }
  
  .search-modal.hidden {
    display: none !important;
  }
  
  .modal-backdrop {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(0, 0, 0, 0.85) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 2147483646 !important;
  }
  
  .modal-container {
    position: fixed !important;
    inset: 0 !important;
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    padding-top: 12vh !important;
    cursor: pointer !important;
    z-index: 2147483647 !important;
  }
  
  .modal-content {
    width: 100%;
    max-width: 640px;
    max-height: 75vh;
    margin: 0 1rem;
    background: #0a0a0a;
    border-radius: 1rem;
    border: 1px solid #27272a;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: default;
  }
  
  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #27272a;
    background: #0f0f0f;
  }

  .search-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #22c55e;
    flex-shrink: 0;
  }
  
  .modal-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.125rem;
    color: #ffffff;
    font-family: inherit;
  }
  
  .modal-search-input::placeholder {
    color: #52525b;
  }
  
  .close-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .kbd-esc {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: inherit;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 0.25rem;
    color: #71717a;
  }
  
  .modal-results {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
  }
  
  .modal-results:empty::before {
    content: 'Type to search across all documents...';
    display: block;
    padding: 3rem 2rem;
    text-align: center;
    color: #52525b;
  }

  .search-category {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #22c55e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }

  .search-category:first-child {
    margin-top: 0;
  }

  .search-result-item {
    display: block;
    padding: 0.75rem 1rem;
    margin: 0.25rem 0;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.15s;
    border: 1px solid transparent;
  }

  .search-result-item:hover {
    background: #18181b;
    border-color: #27272a;
  }

  .search-result-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .search-result-title svg {
    width: 1rem;
    height: 1rem;
    color: #22c55e;
    flex-shrink: 0;
  }

  .search-result-desc {
    font-size: 0.85rem;
    color: #71717a;
    line-height: 1.5;
    padding-left: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result-path {
    font-size: 0.75rem;
    color: #52525b;
    padding-left: 1.5rem;
    margin-top: 0.25rem;
  }

  .search-highlight {
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
    padding: 0 0.125rem;
    border-radius: 0.125rem;
  }

  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    color: #52525b;
  }

  .no-results svg {
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Move modal to body for proper stacking
    const searchModal = document.getElementById('search-modal');
    if (searchModal && searchModal.parentElement !== document.body) {
      document.body.appendChild(searchModal);
    }

    const modalSearchInput = document.getElementById('modal-search-input') as HTMLInputElement;
    const modalSearchResults = document.getElementById('modal-search-results');
    const closeModalBtn = document.getElementById('close-modal');
    const modalContainer = document.getElementById('modal-container');

    // Get search index from window (built at compile time)
    const searchIndex = (window as any).__SEARCH_INDEX__ || [];

    function openModal() {
      searchModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => modalSearchInput?.focus(), 100);
    }

    function closeModal() {
      searchModal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (modalSearchInput) modalSearchInput.value = '';
      if (modalSearchResults) modalSearchResults.innerHTML = '';
    }

    // Expose openModal globally for Navbar
    (window as any).openSearchModal = openModal;

    closeModalBtn?.addEventListener('click', closeModal);
    
    // Click anywhere outside modal content to close
    modalContainer?.addEventListener('click', (e) => {
      if (e.target === modalContainer) {
        closeModal();
      }
    });

    // Highlight matching text
    function highlightMatch(text: string, query: string): string {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<span class="search-highlight">$1</span>');
    }

    // Format category name
    function formatCategory(cat: string): string {
      return cat.split('-').map(word => 
        word.charAt(0).toUpperCase() + word.slice(1)
      ).join(' ');
    }

    // Render search results grouped by category
    function renderResults(query: string) {
      if (!modalSearchResults) return;
      
      if (query.length < 2) {
        modalSearchResults.innerHTML = '';
        return;
      }

      const queryLower = query.toLowerCase();
      
      // Filter and score results
      const filtered = searchIndex
        .filter((item: any) => {
          const searchText = `${item.title} ${item.description} ${item.content}`.toLowerCase();
          return searchText.includes(queryLower);
        })
        .map((item: any) => {
          // Score: title match = 3, description match = 2, content match = 1
          let score = 0;
          if (item.title.toLowerCase().includes(queryLower)) score += 3;
          if (item.description.toLowerCase().includes(queryLower)) score += 2;
          if (item.content.toLowerCase().includes(queryLower)) score += 1;
          return { ...item, score };
        })
        .sort((a: any, b: any) => b.score - a.score)
        .slice(0, 20);

      if (filtered.length === 0) {
        modalSearchResults.innerHTML = `
          <div class="no-results">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p>No results found for "${query}"</p>
          </div>
        `;
        return;
      }

      // Group by category
      const grouped: { [key: string]: any[] } = {};
      filtered.forEach((item: any) => {
        const cat = item.category || 'General';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(item);
      });

      // Render grouped results
      let html = '';
      for (const [category, items] of Object.entries(grouped)) {
        html += `<div class="search-category">${formatCategory(category)}</div>`;
        
        (items as any[]).forEach((item: any) => {
          html += `
            <a href="${item.url}" class="search-result-item" onclick="document.getElementById('search-modal').classList.add('hidden'); document.body.style.overflow = '';">
              <div class="search-result-title">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                ${highlightMatch(item.title, query)}
              </div>
              ${item.description ? `<div class="search-result-desc">${highlightMatch(item.description, query)}</div>` : ''}
              <div class="search-result-path">${item.url}</div>
            </a>
          `;
        });
      }

      modalSearchResults.innerHTML = html;
    }

    // Modal search input handler
    if (modalSearchInput) {
      modalSearchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        renderResults(query);
      });

      modalSearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
        }
      });
    }

    // Global keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openModal();
      }
      if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
