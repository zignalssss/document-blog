---
// Search Modal Component with global search across all documents
// Automatically discovers and indexes all content files

// Read raw file contents using import.meta.glob (auto-discovers all content)
const rawFiles = import.meta.glob('/src/content/**/*.{md,mdx}', {
  query: '?raw',
  import: 'default',
  eager: true
});

interface SearchItem {
  title: string;
  description: string;
  url: string;
  project: string;
  category: string;
  content: string;
  headings: string;
}

interface HeadingItem {
  title: string;
  slug: string;
  url: string;
  parentTitle: string;
  category: string;
}

// Helper to create slug from heading text
function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s\u0E00-\u0E7F-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();
}

// Extract headings from markdown
function extractHeadings(raw: string): { text: string; slug: string }[] {
  const headings: { text: string; slug: string }[] = [];
  const lines = raw.split('\n');

  for (const line of lines) {
    const match = line.match(/^#{1,3}\s+(.+)$/);
    if (match) {
      const text = match[1].trim();
      headings.push({ text, slug: slugify(text) });
    }
  }
  return headings;
}

// Extract frontmatter from raw markdown
function extractFrontmatter(raw: string): Record<string, any> {
  const match = raw.match(/^---\s*\n([\s\S]*?)\n---/);
  if (!match) return {};

  const frontmatter: Record<string, any> = {};
  const lines = match[1].split('\n');

  for (const line of lines) {
    const colonIndex = line.indexOf(':');
    if (colonIndex > 0) {
      const key = line.slice(0, colonIndex).trim();
      let value = line.slice(colonIndex + 1).trim();
      // Remove quotes if present
      if ((value.startsWith('"') && value.endsWith('"')) ||
          (value.startsWith("'") && value.endsWith("'"))) {
        value = value.slice(1, -1);
      }
      frontmatter[key] = value;
    }
  }
  return frontmatter;
}

// Helper function to clean markdown content
function cleanMarkdown(raw: string): string {
  return raw
    .replace(/^---[\s\S]*?---/m, '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]+`/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/#{1,6}\s/g, ' ')
    .replace(/[*_~]+/g, '')
    .replace(/>\s/g, ' ')
    .replace(/\|.*\|/g, ' ')
    .replace(/-{3,}/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

// Build search index automatically from all content files
const searchIndex: SearchItem[] = [];
const headingsIndex: HeadingItem[] = [];

// Process all raw files automatically
for (const [filePath, rawContent] of Object.entries(rawFiles)) {
  const raw = rawContent as string;

  // Parse path: /src/content/{collection}/{...path}.mdx
  const pathMatch = filePath.match(/^\/src\/content\/([^/]+)\/(.+)\.(md|mdx)$/);
  if (!pathMatch) continue;

  const [, collection, docPath] = pathMatch;
  const pathParts = docPath.split('/');
  const category = pathParts[0] || 'General';

  // Extract frontmatter
  const frontmatter = extractFrontmatter(raw);
  const title = frontmatter.title || docPath.split('/').pop() || docPath;
  const description = frontmatter.description || '';

  const cleanContent = cleanMarkdown(raw).slice(0, 3000);
  const headings = extractHeadings(raw);
  const headingsText = headings.map(h => h.text).join(' ');
  const baseUrl = `/${collection}/${docPath}`;

  // Add document to search index
  searchIndex.push({
    title,
    description,
    url: baseUrl,
    project: collection,
    category,
    content: cleanContent,
    headings: headingsText
  });

  // Add each heading as a separate searchable item
  headings.forEach(heading => {
    headingsIndex.push({
      title: heading.text,
      slug: heading.slug,
      url: `${baseUrl}#${heading.slug}`,
      parentTitle: title,
      category
    });
  });
}
---

<!-- Search Modal -->
<div id="search-modal" class="search-modal hidden">
  <div class="modal-backdrop" id="modal-backdrop"></div>
  <div class="modal-container" id="modal-container">
    <div class="modal-content" onclick="event.stopPropagation()">
      <div class="search-input-wrapper">
        <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="modal-search-input"
          placeholder="Search all documentation..."
          class="modal-search-input"
          autocomplete="off"
        />
        <button id="close-modal" class="close-btn">
          <kbd class="kbd-esc">ESC</kbd>
        </button>
      </div>
      <div id="modal-search-results" class="modal-results"></div>
    </div>
  </div>
</div>

<!-- Pass search index to client -->
<script define:vars={{ searchIndex, headingsIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
  window.__HEADINGS_INDEX__ = headingsIndex;
</script>

<style is:global>
  .search-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483647 !important;
  }
  
  .search-modal.hidden {
    display: none !important;
  }
  
  .modal-backdrop {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(0, 0, 0, 0.85) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 2147483646 !important;
  }
  
  .modal-container {
    position: fixed !important;
    inset: 0 !important;
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    padding-top: 12vh !important;
    cursor: pointer !important;
    z-index: 2147483647 !important;
  }
  
  .modal-content {
    width: 100%;
    max-width: 640px;
    max-height: 75vh;
    margin: 0 1rem;
    background: #0a0a0a;
    border-radius: 1rem;
    border: 1px solid #27272a;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: default;
  }
  
  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #27272a;
    background: #0f0f0f;
  }

  .search-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #3b82f6;
    flex-shrink: 0;
  }
  
  .modal-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.125rem;
    color: #ffffff;
    font-family: inherit;
  }
  
  .modal-search-input::placeholder {
    color: #52525b;
  }
  
  .close-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .kbd-esc {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: inherit;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 0.25rem;
    color: #71717a;
  }
  
  .modal-results {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
  }
  
  .modal-results:empty::before {
    content: 'Type to search across all documents...';
    display: block;
    padding: 3rem 2rem;
    text-align: center;
    color: #52525b;
  }

  .search-category {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #3b82f6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }

  .search-category:first-child {
    margin-top: 0;
  }

  .search-result-item {
    display: block;
    padding: 0.75rem 1rem;
    margin: 0.25rem 0;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.15s;
    border: 1px solid transparent;
  }

  .search-result-item:hover {
    background: #18181b;
    border-color: #27272a;
  }

  .search-result-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .search-result-title svg {
    width: 1rem;
    height: 1rem;
    color: #3b82f6;
    flex-shrink: 0;
  }

  .search-result-desc {
    font-size: 0.85rem;
    color: #71717a;
    line-height: 1.5;
    padding-left: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result-path {
    font-size: 0.75rem;
    color: #52525b;
    padding-left: 1.5rem;
    margin-top: 0.25rem;
  }

  .search-highlight {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    padding: 0 0.125rem;
    border-radius: 0.125rem;
  }

  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    color: #52525b;
  }

  .no-results svg {
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
</style>

<script>
  import Fuse from 'fuse.js';

  document.addEventListener('DOMContentLoaded', () => {
    // Move modal to body for proper stacking
    const searchModal = document.getElementById('search-modal');
    if (searchModal && searchModal.parentElement !== document.body) {
      document.body.appendChild(searchModal);
    }

    const modalSearchInput = document.getElementById('modal-search-input') as HTMLInputElement;
    const modalSearchResults = document.getElementById('modal-search-results');
    const closeModalBtn = document.getElementById('close-modal');
    const modalContainer = document.getElementById('modal-container');

    // Get search index from window (built at compile time)
    const searchIndex = (window as any).__SEARCH_INDEX__ || [];
    const headingsIndex = (window as any).__HEADINGS_INDEX__ || [];

    // Initialize Fuse.js for documents
    const fuseDocs = new Fuse(searchIndex, {
      keys: [
        { name: 'title', weight: 0.4 },
        { name: 'description', weight: 0.25 },
        { name: 'headings', weight: 0.2 },
        { name: 'content', weight: 0.15 }
      ],
      threshold: 0.3,
      distance: 100,
      includeScore: true,
      includeMatches: true,
      minMatchCharLength: 2,
      ignoreLocation: true,
      useExtendedSearch: true
    });

    // Initialize Fuse.js for headings
    const fuseHeadings = new Fuse(headingsIndex, {
      keys: [
        { name: 'title', weight: 0.7 },
        { name: 'parentTitle', weight: 0.3 }
      ],
      threshold: 0.3,
      distance: 100,
      includeScore: true,
      includeMatches: true,
      minMatchCharLength: 2,
      ignoreLocation: true
    });

    function openModal() {
      searchModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => modalSearchInput?.focus(), 100);
    }

    function closeModal() {
      searchModal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (modalSearchInput) modalSearchInput.value = '';
      if (modalSearchResults) modalSearchResults.innerHTML = '';
    }

    // Expose openModal globally for Navbar
    (window as any).openSearchModal = openModal;

    closeModalBtn?.addEventListener('click', closeModal);

    // Click anywhere outside modal content to close
    modalContainer?.addEventListener('click', (e) => {
      if (e.target === modalContainer) {
        closeModal();
      }
    });

    // Highlight matching text using Fuse.js matches
    function highlightMatches(text: string, matches: any[] | undefined, key: string): string {
      if (!matches) return text;

      const match = matches.find((m: any) => m.key === key);
      if (!match || !match.indices) return text;

      let result = '';
      let lastIndex = 0;

      // Sort indices by start position
      const sortedIndices = [...match.indices].sort((a, b) => a[0] - b[0]);

      for (const [start, end] of sortedIndices) {
        result += text.slice(lastIndex, start);
        result += `<span class="search-highlight">${text.slice(start, end + 1)}</span>`;
        lastIndex = end + 1;
      }
      result += text.slice(lastIndex);

      return result;
    }

    // Format category name
    function formatCategory(cat: string): string {
      return cat.split('-').map(word =>
        word.charAt(0).toUpperCase() + word.slice(1)
      ).join(' ');
    }

    // Render search results grouped by category
    function renderResults(query: string) {
      if (!modalSearchResults) return;

      if (query.length < 2) {
        modalSearchResults.innerHTML = '';
        return;
      }

      // Search using Fuse.js
      const docResults = fuseDocs.search(query, { limit: 15 });
      const headingResults = fuseHeadings.search(query, { limit: 10 });

      if (docResults.length === 0 && headingResults.length === 0) {
        modalSearchResults.innerHTML = `
          <div class="no-results">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p>No results found for "${query}"</p>
          </div>
        `;
        return;
      }

      // Group docs by category
      const groupedDocs: { [key: string]: any[] } = {};
      docResults.forEach((result: any) => {
        const item = result.item;
        const cat = item.category || 'General';
        if (!groupedDocs[cat]) groupedDocs[cat] = [];
        groupedDocs[cat].push({ ...item, matches: result.matches, score: result.score });
      });

      // Render results
      let html = '';

      // Render document results
      for (const [category, items] of Object.entries(groupedDocs)) {
        html += `<div class="search-category">${formatCategory(category)}</div>`;

        (items as any[]).forEach((item: any) => {
          const titleHighlighted = highlightMatches(item.title, item.matches, 'title');
          const descHighlighted = item.description ? highlightMatches(item.description, item.matches, 'description') : '';

          html += `
            <a href="${item.url}" class="search-result-item" onclick="document.getElementById('search-modal').classList.add('hidden'); document.body.style.overflow = '';">
              <div class="search-result-title">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                ${titleHighlighted}
              </div>
              ${descHighlighted ? `<div class="search-result-desc">${descHighlighted}</div>` : ''}
              <div class="search-result-path">${item.url}</div>
            </a>
          `;
        });
      }

      // Render heading results
      if (headingResults.length > 0) {
        html += `<div class="search-category">Sections</div>`;

        headingResults.forEach((result: any) => {
          const item = result.item;
          const titleHighlighted = highlightMatches(item.title, result.matches, 'title');

          html += `
            <a href="${item.url}" class="search-result-item" onclick="document.getElementById('search-modal').classList.add('hidden'); document.body.style.overflow = '';">
              <div class="search-result-title">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                </svg>
                ${titleHighlighted}
              </div>
              <div class="search-result-desc">ใน ${item.parentTitle}</div>
              <div class="search-result-path">${item.url}</div>
            </a>
          `;
        });
      }

      modalSearchResults.innerHTML = html;
    }

    // Modal search input handler
    if (modalSearchInput) {
      modalSearchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        renderResults(query);
      });

      modalSearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
        }
      });
    }

    // Global keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openModal();
      }
      if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
