---
import type { SidebarProps, NavSection, NavItem } from '../types';

type Props = SidebarProps;

const { currentPath, navigation = [], projectTitle, baseUrl } = Astro.props;
const title = projectTitle || 'Documentation';
const urlBase = baseUrl || '/docs';

const isActive = (slug: string) => {
  return currentPath.includes(`${urlBase}/${slug}`) || currentPath.includes(`/${slug}`);
};

const isSectionActive = (section: NavSection) => {
  return section.items.some(item => isActive(item.slug));
};
---

<aside class="sticky top-8 h-fit p-6 ">
  <div class="mb-6">
    {baseUrl && <a href="/" class="inline-block text-blue-400 no-underline text-base mb-4 hover:text-blue-300 transition-colors">← กลับหน้าหลัก</a>}
    <h2 class="text-xl font-bold text-slate-50 mb-4">{title}</h2>
    
    <!-- Search Button -->
    <button 
      id="search-trigger"
      class="w-full flex items-center gap-3 px-3 py-2 bg-slate-700/50 border border-slate-600 rounded-lg text-slate-400 text-sm hover:bg-slate-700 hover:border-slate-500 transition-all cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <span>Search...</span>
      <kbd class="ml-auto text-xs bg-slate-600 px-1.5 py-0.5 rounded">⌘K</kbd>
    </button>
  </div>
  
  {navigation && navigation.length > 0 ? (
    <nav>
      {navigation.map((section: NavSection) => (
        <div class="mb-4 section-group" data-active={isSectionActive(section)}>
          <button 
            class="section-toggle w-full flex items-center justify-between text-base font-semibold text-slate-400 uppercase tracking-wider py-2 px-2 rounded-md hover:bg-slate-700 hover:text-slate-300 transition-all cursor-pointer bg-transparent border-none text-left"
            aria-expanded={isSectionActive(section) ? "true" : "false"}
          >
            <span>{section.title}</span>
            <svg class="chevron w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <ul class="section-items list-none p-0 m-0 overflow-hidden transition-all duration-200 pl-2">
            {section.items.map((item: NavItem) => (
              <li class="mb-1">
                <a 
                  href={baseUrl ? `${baseUrl}/${item.slug}` : `/docs/${item.slug}`}
                  class:list={[
                    'block px-3 py-2 text-slate-300 no-underline rounded-md transition-all text-base',
                    isActive(item.slug) ? 'bg-blue-600 text-white font-medium' : 'hover:bg-slate-700 hover:text-slate-50'
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  ) : (
    <p class="text-slate-400 text-base">No navigation available</p>
  )}
</aside>

<!-- Search Modal -->
<div id="search-modal" class="search-modal hidden">
  <div class="modal-backdrop" id="modal-backdrop"></div>
  <div class="modal-container" id="modal-container">
    <div class="modal-content" onclick="event.stopPropagation()">
      <div class="search-input-wrapper">
        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          type="text" 
          id="modal-search-input"
          placeholder="Search in this page..."
          class="modal-search-input"
          autocomplete="off"
        />
        <button id="close-modal" class="close-btn">
          <kbd class="text-xs bg-slate-600 px-2 py-1 rounded">ESC</kbd>
        </button>
      </div>
      <div id="modal-search-results" class="modal-results"></div>
    </div>
  </div>
</div>

<style is:global>
  .search-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483647 !important;
  }
  
  .search-modal.hidden {
    display: none !important;
  }
  
  .modal-backdrop {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(0, 0, 0, 0.9) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    z-index: 2147483646 !important;
  }
  
  .modal-container {
    position: fixed !important;
    inset: 0 !important;
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    padding-top: 15vh !important;
    cursor: pointer !important;
    z-index: 2147483647 !important;
  }
  
  .modal-content {
    width: 100%;
    max-width: 600px;
    max-height: 70vh;
    margin: 0 1rem;
    background: #1e293b;
    border-radius: 1rem;
    border: 1px solid #334155;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: default;
  }
  
  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #334155;
  }
  
  .modal-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.125rem;
    color: #f1f5f9;
  }
  
  .modal-search-input::placeholder {
    color: #64748b;
  }
  
  .close-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #94a3b8;
  }
  
  .modal-results {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
  }
  
  .modal-results:empty::before {
    content: 'Type to search...';
    display: block;
    padding: 2rem;
    text-align: center;
    color: #64748b;
  }
  
  .section-group[data-active="false"] .section-items {
    max-height: 0;
    opacity: 0;
  }
  
  .section-group[data-active="true"] .section-items {
    max-height: 500px;
    opacity: 1;
  }
  
  .section-group[data-active="true"] .chevron {
    transform: rotate(180deg);
  }
  
  .section-group[data-active="false"] .chevron {
    transform: rotate(0deg);
  }

  @media (max-width: 1024px) {
    aside {
      position: relative;
      top: 0;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Section toggle functionality
    const toggles = document.querySelectorAll('.section-toggle');
    
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const group = toggle.closest('.section-group');
        if (group) {
          const isActive = group.getAttribute('data-active') === 'true';
          group.setAttribute('data-active', (!isActive).toString());
          toggle.setAttribute('aria-expanded', (!isActive).toString());
        }
      });
    });

    // Move modal to body for proper stacking
    const searchModal = document.getElementById('search-modal');
    if (searchModal && searchModal.parentElement !== document.body) {
      document.body.appendChild(searchModal);
    }

    // Search Modal functionality
    const searchTrigger = document.getElementById('search-trigger');
    const modalSearchInput = document.getElementById('modal-search-input') as HTMLInputElement;
    const modalSearchResults = document.getElementById('modal-search-results');
    const closeModalBtn = document.getElementById('close-modal');
    const modalContainer = document.getElementById('modal-container');

    function openModal() {
      searchModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => modalSearchInput?.focus(), 100);
    }

    function closeModal() {
      searchModal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (modalSearchInput) modalSearchInput.value = '';
      if (modalSearchResults) modalSearchResults.innerHTML = '';
    }

    searchTrigger?.addEventListener('click', openModal);
    closeModalBtn?.addEventListener('click', closeModal);
    
    // Click anywhere outside modal content to close
    modalContainer?.addEventListener('click', (e) => {
      if (e.target === modalContainer) {
        closeModal();
      }
    });

    // Full-text search in current page
    const searchInput = document.getElementById('sidebar-search') as HTMLInputElement;
    const searchResults = document.getElementById('search-results');
    
    interface SearchResult {
      text: string;
      heading: string;
      headingId: string;
      context: string;
      type: 'heading' | 'content';
    }

    // Build search index from page content
    function buildSearchIndex(): SearchResult[] {
      const content = document.querySelector('.content');
      if (!content) return [];
      
      const results: SearchResult[] = [];
      
      // First, map all headings and add them to search index
      const headings = content.querySelectorAll('h1, h2, h3, h4');
      const headingPositions: {el: Element, top: number, text: string, id: string}[] = [];
      
      headings.forEach(h => {
        const text = h.textContent || '';
        const id = h.id || '';
        
        headingPositions.push({
          el: h,
          top: (h as HTMLElement).offsetTop,
          text: text,
          id: id
        });
        
        // Add heading itself to search results
        results.push({
          text: text,
          heading: text,
          headingId: id,
          context: text,
          type: 'heading'
        });
      });
      
      // Process paragraphs and list items
      const textElements = content.querySelectorAll('p, li, td, th, blockquote');
      
      textElements.forEach(el => {
        const text = el.textContent?.trim() || '';
        if (text.length < 10) return; // Skip very short text
        
        // Find the closest heading above this element
        const elTop = (el as HTMLElement).offsetTop;
        let closestHeading = { text: 'Content', id: '' };
        
        for (let i = headingPositions.length - 1; i >= 0; i--) {
          if (headingPositions[i].top <= elTop) {
            closestHeading = { text: headingPositions[i].text, id: headingPositions[i].id };
            break;
          }
        }
        
        results.push({
          text: text,
          heading: closestHeading.text,
          headingId: closestHeading.id,
          context: text.slice(0, 150) + (text.length > 150 ? '...' : ''),
          type: 'content'
        });
      });
      
      return results;
    }

    let searchIndex: SearchResult[] = [];
    
    // Build index after page loads
    setTimeout(() => {
      searchIndex = buildSearchIndex();
    }, 500);

    // Highlight matching text
    const highlightMatch = (text: string, query: string) => {
      const regex = new RegExp(`(${query})`, 'gi');
      return text.replace(regex, '<mark class="bg-yellow-500/30 text-yellow-200 px-0.5 rounded">$1</mark>');
    };

    // Render search results
    function renderResults(query: string, container: HTMLElement) {
      if (query.length < 2) {
        container.innerHTML = '';
        return;
      }

      const filtered = searchIndex.filter(item => 
        item.text.toLowerCase().includes(query)
      ).slice(0, 15);

      if (filtered.length > 0) {
        container.innerHTML = filtered.map(item => {
          const isHeading = item.type === 'heading';
          return `
            <a href="#${item.headingId}" class="search-result-item block px-4 py-3 text-sm text-slate-300 hover:bg-slate-700/50 transition-colors rounded-lg mb-1" onclick="document.getElementById('search-modal').classList.add('hidden'); document.body.style.overflow = '';">
              ${isHeading ? `
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                  </svg>
                  <span class="font-medium text-emerald-400 text-base">${highlightMatch(item.context, query)}</span>
                </div>
              ` : `
                <div class="flex items-center gap-2 text-blue-400 text-xs mb-1.5 font-medium">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  ${item.heading}
                </div>
                <div class="text-slate-400 text-sm leading-relaxed pl-6">${highlightMatch(item.context, query)}</div>
              `}
            </a>
          `;
        }).join('');
      } else {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center py-12 text-slate-400">
            <svg class="w-12 h-12 mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p>No results found for "${query}"</p>
          </div>
        `;
      }
    }

    // Modal search input handler
    if (modalSearchInput && modalSearchResults) {
      modalSearchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        renderResults(query, modalSearchResults);
      });

      modalSearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
        }
      });
    }

    // Global keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openModal();
      }
      if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
