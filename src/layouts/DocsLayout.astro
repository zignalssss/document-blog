---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { DocsLayoutProps, BreadcrumbItem } from '../types';

type Props = DocsLayoutProps;

const { title, description, headings, navigation, currentPath, projectTitle, baseUrl } = Astro.props;

// สร้าง breadcrumb items จาก current path
const pathParts = (currentPath || Astro.url.pathname).split('/').filter(Boolean);
const breadcrumbItems: BreadcrumbItem[] = [];

if (projectTitle && baseUrl) {
  breadcrumbItems.push({
    label: projectTitle.replace(/^[^\s]+\s/, ''), // ลบ emoji
    href: baseUrl
  });
}

// หา section และ page title จาก navigation
if (navigation && pathParts.length >= 2) {
  const currentSlug = pathParts.slice(1).join('/');
  for (const section of navigation) {
    const foundItem = section.items.find(item => item.slug === currentSlug);
    if (foundItem) {
      breadcrumbItems.push({
        label: section.title,
        href: undefined
      });
      breadcrumbItems.push({
        label: foundItem.title
      });
      break;
    }
  }
}
const hasCustomSidebar = Astro.slots.has('sidebar');
---

<Layout title={title}>
  <div class="blog-layout">
    <aside class="sidebar-nav">
      {hasCustomSidebar ? (
        <slot name="sidebar" />
      ) : navigation ? (
        <Sidebar 
          navigation={navigation} 
          currentPath={currentPath || Astro.url.pathname}
          projectTitle={projectTitle}
          baseUrl={baseUrl}
        />
      ) : (
        <Sidebar currentPath={Astro.url.pathname} />
      )}
    </aside>

    <main class="blog-content">
      <article>
        {breadcrumbItems.length > 0 && (
          <Breadcrumb items={breadcrumbItems} />
        )}
        <header class="article-header">
          <h1>{title}</h1>
          <p class="description">{description}</p>
        </header>
        
        <div class="content">
          <slot />
        </div>
      </article>
    </main>

    <aside class="toc-nav">
      <Toc headings={headings} />
    </aside>
  </div>
</Layout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: 280px 1fr 450px;
    width: 100%;
    gap: 5rem;
    padding: 2rem 1.5rem;
    min-height: 100vh;
  }

  .sidebar-nav {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .blog-content {
    width: 100%;
  }

  .toc-nav {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .article-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }

  .article-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .article-header .description {
    font-size: 1.1rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.5;
  }

  .content {
    font-size: 1rem;
    line-height: 1.7;
    color: #cbd5e1;
  }

  .content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem 0;
    color: #f1f5f9;
    letter-spacing: -0.01em;
  }

  .content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem 0;
    color: #e2e8f0;
  }

  .content :global(p) {
    margin: 0 0 0.75rem 0;
    color: #cbd5e1;
  }

  .content :global(strong) {
    color: #f1f5f9;
    font-weight: 600;
  }

  .content :global(pre) {
    margin: 1rem 0;
    padding: 1rem;
    background: #1e293b;
    border-radius: 0.5rem;
    overflow-x: auto;
    border: 1px solid #334155;
  }

  .content :global(pre code) {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #e2e8f0;
  }

  .content :global(p code),
  .content :global(li code) {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 0;
  }

  .content :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.9;
  }

  .content :global(a) {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .content :global(a:hover) {
    color: #93c5fd;
    text-decoration: underline;
  }

  .content :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 4px solid #3b82f6;
    color: #94a3b8;
    font-style: italic;
  }

  .content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
  }

  .content :global(th),
  .content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid #334155;
    text-align: left;
  }

  .content :global(th) {
    background: #1e293b;
    font-weight: 600;
    color: #f1f5f9;
  }

  .content :global(td) {
    color: #cbd5e1;
  }

  .content :global(tr:hover) {
    background: rgba(30, 41, 59, 0.5);
  }

  @media (max-width: 1280px) {
    .blog-layout {
      grid-template-columns: 250px 1fr;
      gap: 2rem;
    }

    .toc-nav {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .blog-layout {
      grid-template-columns: 1fr;
      padding: 2rem 1rem;
    }

    .sidebar-nav {
      position: relative;
      top: 0;
    }

    .article-header h1 {
      font-size: 2rem;
    }

    .article-header .description {
      font-size: 1.125rem;
    }

    .content {
      font-size: 1rem;
    }
  }
</style>
