---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';

interface NavItem {
  title: string;
  slug: string;
}

interface NavSection {
  title: string;
  slug: string;
  items: NavItem[];
}

interface Props {
  title: string;
  description: string;
  headings: any[];
  navigation?: NavSection[];
  currentPath?: string;
  projectTitle?: string;
  baseUrl?: string;
}

const { title, description, headings, navigation, currentPath, projectTitle, baseUrl } = Astro.props;
const hasCustomSidebar = Astro.slots.has('sidebar');
---

<Layout title={title}>
  <div class="blog-layout">
    <aside class="sidebar-nav">
      {hasCustomSidebar ? (
        <slot name="sidebar" />
      ) : navigation ? (
        <Sidebar 
          navigation={navigation} 
          currentPath={currentPath || Astro.url.pathname}
          projectTitle={projectTitle}
          baseUrl={baseUrl}
        />
      ) : (
        <Sidebar currentPath={Astro.url.pathname} />
      )}
    </aside>

    <main class="blog-content">
      <article>
        <header class="article-header">
          <h1>{title}</h1>
          <p class="description">{description}</p>
        </header>
        
        <div class="content">
          <slot />
        </div>
      </article>
    </main>

    <aside class="toc-nav">
      <Toc headings={headings} />
    </aside>
  </div>
</Layout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: 280px 1fr 250px;
    max-width: 1600px;
    margin: 0 auto;
    gap: 3rem;
    padding: 3rem 2rem;
    min-height: 100vh;
  }

  .sidebar-nav {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .blog-content {
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .toc-nav {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid rgba(51, 65, 85, 0.5);
  }

  .article-header h1 {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .article-header .description {
    font-size: 1.25rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.6;
  }

  .content {
    font-size: 1.0625rem;
    line-height: 1.9;
    color: #cbd5e1;
  }

  .content :global(h2) {
    font-size: 2rem;
    font-weight: 700;
    margin: 3.5rem 0 1.5rem 0;
    color: #f1f5f9;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #334155;
    letter-spacing: -0.01em;
  }

  .content :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1.25rem 0;
    color: #e2e8f0;
  }

  .content :global(p) {
    margin: 0 0 1.5rem 0;
    color: #cbd5e1;
  }

  .content :global(strong) {
    color: #f1f5f9;
    font-weight: 600;
  }

  .content :global(pre) {
    margin: 2rem 0;
    padding: 1.5rem;
    background: #1e293b;
    border-radius: 0.5rem;
    overflow-x: auto;
    border: 1px solid #334155;
  }

  .content :global(pre code) {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #e2e8f0;
  }

  .content :global(p code),
  .content :global(li code) {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 0;
  }

  .content :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.9;
  }

  .content :global(a) {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .content :global(a:hover) {
    color: #93c5fd;
    text-decoration: underline;
  }

  .content :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 4px solid #3b82f6;
    color: #94a3b8;
    font-style: italic;
  }

  .content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
  }

  .content :global(th),
  .content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid #334155;
    text-align: left;
  }

  .content :global(th) {
    background: #1e293b;
    font-weight: 600;
    color: #f1f5f9;
  }

  .content :global(td) {
    color: #cbd5e1;
  }

  .content :global(tr:hover) {
    background: rgba(30, 41, 59, 0.5);
  }

  @media (max-width: 1280px) {
    .blog-layout {
      grid-template-columns: 250px 1fr;
      gap: 2rem;
    }

    .toc-nav {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .blog-layout {
      grid-template-columns: 1fr;
      padding: 2rem 1rem;
    }

    .sidebar-nav {
      position: relative;
      top: 0;
    }

    .article-header h1 {
      font-size: 2rem;
    }

    .article-header .description {
      font-size: 1.125rem;
    }

    .content {
      font-size: 1rem;
    }
  }
</style>
