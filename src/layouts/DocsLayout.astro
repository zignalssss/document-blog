---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { DocsLayoutProps, BreadcrumbItem } from '../types';

type Props = DocsLayoutProps;

const { title, description, headings, navigation, currentPath, projectTitle, baseUrl } = Astro.props;

// สร้าง breadcrumb items จาก current path
const pathParts = (currentPath || Astro.url.pathname).split('/').filter(Boolean);
const breadcrumbItems: BreadcrumbItem[] = [];

if (projectTitle && baseUrl) {
  breadcrumbItems.push({
    label: projectTitle.replace(/^[^\s]+\s/, ''), // ลบ emoji
    href: baseUrl
  });
}

// หา section และ page title จาก navigation
if (navigation && pathParts.length >= 2) {
  const currentSlug = pathParts.slice(1).join('/');
  for (const section of navigation) {
    const foundItem = section.items.find(item => item.slug === currentSlug);
    if (foundItem) {
      breadcrumbItems.push({
        label: section.title,
        href: undefined
      });
      breadcrumbItems.push({
        label: foundItem.title
      });
      break;
    }
  }
}
const hasCustomSidebar = Astro.slots.has('sidebar');
---

<Layout title={title}>
  <!-- Mobile Navbar -->
  <header class="mobile-navbar">
    <button id="mobile-menu-toggle" class="hamburger-btn" aria-label="Toggle menu">
      <svg class="hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg class="close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <span class="mobile-title">{projectTitle || 'Documentation'}</span>
    <button id="mobile-search-trigger" class="mobile-search-btn" aria-label="Search">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </button>
  </header>

  <!-- Mobile Sidebar Overlay -->
  <div id="mobile-sidebar-overlay" class="mobile-overlay hidden"></div>
  
  <!-- Mobile Sidebar -->
  <div id="mobile-sidebar" class="mobile-sidebar">
    <div class="mobile-sidebar-content">
      {baseUrl && <a href="/" class="inline-block text-blue-400 no-underline text-base mb-4 hover:text-blue-300 transition-colors">← กลับหน้าหลัก</a>}      
      {navigation && navigation.length > 0 && (
        <nav>
          {navigation.map((section) => (
            <div class="mb-4 mobile-section-group" data-active="true">
              <button 
                class="mobile-section-toggle w-full flex items-center justify-between text-base font-semibold text-slate-400 uppercase tracking-wider py-2 px-2 rounded-md hover:bg-slate-700 hover:text-slate-300 transition-all cursor-pointer bg-transparent border-none text-left"
                aria-expanded="true"
              >
                <span>{section.title}</span>
                <svg class="chevron w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <ul class="mobile-section-items list-none p-0 m-0 pl-2">
                {section.items.map((item) => (
                  <li class="mb-1">
                    <a 
                      href={baseUrl ? `${baseUrl}/${item.slug}` : `/docs/${item.slug}`}
                      class:list={[
                        'block px-3 py-2 text-slate-300 no-underline rounded-md transition-all text-base',
                        (currentPath || Astro.url.pathname).includes(item.slug) ? 'bg-blue-600 text-white font-medium' : 'hover:bg-slate-700 hover:text-slate-50'
                      ]}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}
    </div>
  </div>

  <div class="blog-layout">
    <aside class="sidebar-nav">
      {hasCustomSidebar ? (
        <slot name="sidebar" />
      ) : navigation ? (
        <Sidebar 
          navigation={navigation} 
          currentPath={currentPath || Astro.url.pathname}
          projectTitle={projectTitle}
          baseUrl={baseUrl}
        />
      ) : (
        <Sidebar currentPath={Astro.url.pathname} />
      )}
    </aside>

    <main class="blog-content">
      <article>
        {breadcrumbItems.length > 0 && (
          <Breadcrumb items={breadcrumbItems} />
        )}
        <header class="article-header">
          <h1>{title}</h1>
          <p class="description">{description}</p>
        </header>
        
        <div class="content">
          <slot />
        </div>
      </article>
    </main>

    <aside class="toc-nav">
      <Toc headings={headings} />
    </aside>
  </div>
</Layout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: 280px 1fr 450px;
    width: 100%;
    gap: 5rem;
    padding: 2rem 1.5rem;
    min-height: 100vh;
  }

  .sidebar-nav {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .blog-content {
    width: 100%;
  }

  .toc-nav {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .article-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }

  .article-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .article-header .description {
    font-size: 1.1rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.5;
  }

  .content {
    font-size: 1rem;
    line-height: 1.7;
    color: #cbd5e1;
  }

  .content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem 0;
    color: #f1f5f9;
    letter-spacing: -0.01em;
  }

  .content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem 0;
    color: #e2e8f0;
  }

  .content :global(p) {
    margin: 0 0 0.75rem 0;
    color: #cbd5e1;
  }

  .content :global(strong) {
    color: #f1f5f9;
    font-weight: 600;
  }

  .content :global(pre) {
    position: relative;
    margin: 1rem 0;
    padding: 1rem;
    background: #1e293b;
    border-radius: 0.5rem;
    overflow-x: auto;
    border: 1px solid #334155;
  }

  .content :global(pre .copy-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.35rem 0.6rem;
    background: #334155;
    border: 1px solid #475569;
    border-radius: 0.375rem;
    color: #94a3b8;
    font-size: 0.75rem;
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s;
  }

  .content :global(pre:hover .copy-button) {
    opacity: 1;
  }

  .content :global(pre .copy-button:hover) {
    background: #475569;
    color: #e2e8f0;
  }

  .content :global(pre .copy-button.copied) {
    background: #065f46;
    border-color: #10b981;
    color: #10b981;
  }

  .content :global(pre code) {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #e2e8f0;
  }

  .content :global(p code),
  .content :global(li code) {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 0;
  }

  .content :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.9;
  }

  .content :global(a) {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .content :global(a:hover) {
    color: #93c5fd;
    text-decoration: underline;
  }

  .content :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 4px solid #3b82f6;
    color: #94a3b8;
    font-style: italic;
  }

  .content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
  }

  .content :global(th),
  .content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid #334155;
    text-align: left;
  }

  .content :global(th) {
    background: #1e293b;
    font-weight: 600;
    color: #f1f5f9;
  }

  .content :global(td) {
    color: #cbd5e1;
  }

  .content :global(tr:hover) {
    background: rgba(30, 41, 59, 0.5);
  }

  @media (max-width: 1280px) {
    .blog-layout {
      grid-template-columns: 250px 1fr;
      gap: 2rem;
    }

    .toc-nav {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .blog-layout {
      grid-template-columns: 1fr;
      padding: 1rem;
      padding-top: 4.5rem;
    }

    .sidebar-nav {
      display: none;
    }

    .article-header h1 {
      font-size: 1.75rem;
    }

    .article-header .description {
      font-size: 1rem;
    }

    .content {
      font-size: 1rem;
    }
  }

  /* Mobile Navbar */
  .mobile-navbar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3.5rem;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #334155;
    z-index: 1000;
    padding: 0 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: none;
    color: #e2e8f0;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background 0.2s;
  }

  .hamburger-btn:hover {
    background: rgba(71, 85, 105, 0.5);
  }

  .hamburger-btn svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .hamburger-btn .hidden {
    display: none;
  }

  .mobile-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #f1f5f9;
    text-align: center;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: all 0.2s;
  }

  .mobile-search-btn:hover {
    background: rgba(71, 85, 105, 0.5);
    color: #e2e8f0;
  }

  /* Mobile Overlay */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-overlay.visible {
    opacity: 1;
  }

  .mobile-overlay.hidden {
    display: none;
  }

  /* Mobile Sidebar */
  .mobile-sidebar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    max-width: 85vw;
    height: 100vh;
    height: 100dvh;
    background: #0f172a;
    border-right: 1px solid #334155;
    z-index: 999;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
  }

  .mobile-sidebar.open {
    transform: translateX(0);
  }

  .mobile-sidebar-content {
    padding: 1.5rem;
    padding-top: 1rem;
  }

  .mobile-section-group[data-active="true"] .mobile-section-items {
    max-height: 1000px;
    opacity: 1;
  }

  .mobile-section-group[data-active="false"] .mobile-section-items {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
  }

  .mobile-section-group[data-active="true"] .chevron {
    transform: rotate(180deg);
  }

  .mobile-section-group[data-active="false"] .chevron {
    transform: rotate(0deg);
  }

  @media (max-width: 768px) {
    .mobile-navbar {
      display: flex;
    }

    .mobile-sidebar {
      display: block;
    }

    .mobile-overlay {
      display: block;
    }
  }
</style>

<script>
  // Mobile sidebar toggle
  document.addEventListener('DOMContentLoaded', () => {
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const mobileSidebar = document.getElementById('mobile-sidebar');
    const mobileOverlay = document.getElementById('mobile-sidebar-overlay');
    const hamburgerIcon = menuToggle?.querySelector('.hamburger-icon');
    const closeIcon = menuToggle?.querySelector('.close-icon');
    const mobileSearchTrigger = document.getElementById('mobile-search-trigger');

    function openMobileSidebar() {
      mobileSidebar?.classList.add('open');
      mobileOverlay?.classList.remove('hidden');
      setTimeout(() => mobileOverlay?.classList.add('visible'), 10);
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileSidebar() {
      mobileSidebar?.classList.remove('open');
      mobileOverlay?.classList.remove('visible');
      setTimeout(() => mobileOverlay?.classList.add('hidden'), 300);
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    menuToggle?.addEventListener('click', () => {
      if (mobileSidebar?.classList.contains('open')) {
        closeMobileSidebar();
      } else {
        openMobileSidebar();
      }
    });

    mobileOverlay?.addEventListener('click', closeMobileSidebar);

    // Mobile section toggles
    const mobileToggles = document.querySelectorAll('.mobile-section-toggle');
    mobileToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const group = toggle.closest('.mobile-section-group');
        if (group) {
          const isActive = group.getAttribute('data-active') === 'true';
          group.setAttribute('data-active', (!isActive).toString());
          toggle.setAttribute('aria-expanded', (!isActive).toString());
        }
      });
    });

    // Close sidebar when clicking a link
    const sidebarLinks = mobileSidebar?.querySelectorAll('a');
    sidebarLinks?.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileSidebar();
      });
    });

    // Mobile search trigger - open the main search modal
    mobileSearchTrigger?.addEventListener('click', () => {
      const searchModal = document.getElementById('search-modal');
      if (searchModal) {
        searchModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        const searchInput = document.getElementById('modal-search-input') as HTMLInputElement;
        setTimeout(() => searchInput?.focus(), 100);
      }
    });
  });
</script>

<script>
  // Add copy button to all code blocks
  document.addEventListener('DOMContentLoaded', () => {
    const codeBlocks = document.querySelectorAll('.content pre');
    
    // Clipboard icon SVG
    const clipboardIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
    
    // Check icon SVG
    const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
    
    codeBlocks.forEach((pre) => {
      // Create copy button
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-button';
      copyButton.innerHTML = clipboardIcon;
      copyButton.title = 'Copy code';
      
      copyButton.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.textContent : pre.textContent;
        
        try {
          await navigator.clipboard.writeText(text || '');
          copyButton.innerHTML = checkIcon;
          copyButton.classList.add('copied');
          
          setTimeout(() => {
            copyButton.innerHTML = clipboardIcon;
            copyButton.classList.remove('copied');
          }, 2000);
        } catch (err) {
          copyButton.innerHTML = clipboardIcon;
        }
      });
      
      pre.appendChild(copyButton);
    });
  });
</script>
