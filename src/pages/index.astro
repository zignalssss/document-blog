---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SearchModal from '../components/SearchModal.astro';
import projectsConfig from '../../projects-config.json';

const { projects } = projectsConfig;

const projectLinks = await Promise.all(projects.map(async (project) => {
  try {
    const configModule = await import(`../content/${project.id}/docs-config.json`);
    const { navigation } = configModule.default;

    const firstSlug = navigation[0]?.items[0]?.slug || 'introduction';
    return {
      ...project,
      url: `/${project.id}/${firstSlug}`
    };
  } catch {
    return {
      ...project,
      url: `/${project.id}/getting-started/introduction`
    };
  }
}));
---

<Layout title="Documentation Hub">
  <Navbar 
    projectTitle="Documentation Hub"
  />
  <SearchModal />
  
  <div class="min-h-screen bg-zinc-950 py-16 px-8 pt-24">
    <header class="text-center mb-12">
      <h1 class="text-3xl font-bold text-white mb-4">Documentation Hub</h1>
      <p class="text-xl text-zinc-400">เลือก Topic ที่ต้องการเรียนรู้</p>
    </header>

    <div class="max-w-2xl mx-auto mb-16">
      <ul class="space-y-2">
        {projectLinks.map((project) => (
          <li>
            <a 
              href={project.url} 
              class="group flex items-center gap-4 px-5 py-4 bg-zinc-900/50 border border-zinc-800 rounded-lg no-underline transition-all duration-200 hover:bg-zinc-800 hover:border-zinc-700"
            >
              {project.icon && (
                <img 
                  src={project.icon} 
                  alt={`${project.title} icon`} 
                  class="w-8 h-8 flex-shrink-0"
                />
              )}
              <div class="flex-1 min-w-0">
                <h2 class="text-lg font-medium text-white group-hover:text-blue-400 transition-colors">{project.title}</h2>
                <p class="text-sm text-zinc-500 truncate">{project.description}</p>
              </div>
              <svg class="w-5 h-5 text-zinc-600 group-hover:text-blue-400 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <footer class="text-center text-zinc-500 text-base">
      <p>เลือก documentation ที่ต้องการด้านบน</p>
    </footer>
  </div>
</Layout>

<style>
  @media (max-width: 768px) {
    .max-w-2xl {
      padding: 0 0.5rem;
    }
  }
</style>
